# ローカル開発用シークレットのテンプレート（.dev.vars はコミット禁止）。
# `npm run db:up` が .dev.vars に無いキー（DEVICE_AUTH_SECRET / MOCK_MAIL / PIN_PBKDF2_ITERATIONS）を
# 生成して追記する。それ以外は手で埋める。wrangler dev はカレントの .dev.vars を env に注入する。
#
# DB 接続はここに置かない（npm run dev がリポジトリ直下 .env の DATABASE_URL を Hyperdrive の
# ローカル接続先として渡す。scripts/dev.mjs）。

# --- ログイン（workers-auth deviceAuth）---
# 32 文字以上・十分なエントロピー。写真 URL の署名鍵もここから派生する。本番は wrangler secret put。
DEVICE_AUTH_SECRET="<npm run db:up が生成>"
# ローカルではログインコードを wrangler dev のログに出す（localhost からのリクエストだけで効く）。
MOCK_MAIL="1"
# PIN の PBKDF2 反復回数。ローカルは軽くしてよい（本番は未設定 = 100,000）。
PIN_PBKDF2_ITERATIONS="1000"
# 実メールを試すときだけ（MOCK_MAIL を消して設定する）。送信元は tomu-ai.dev のアドレス。
# RESEND_API_KEY="<re_...>"
# MAIL_FROM="Pollenia <noreply@tomu-ai.dev>"

# --- AI（Phase 3: 育種相談・出品文生成）---
# Anthropic API キー。未設定だと /api/ai/* は 500 になる（他機能には影響しない）。
ANTHROPIC_API_KEY="<Anthropic API key>"

# 埋め込みプロバイダー（任意）。どちらも無ければ決定的な mock 埋め込みで動く。
# OPENAI_API_KEY="<OpenAI API key (text-embedding-3-small)>"
# VOYAGE_API_KEY="<Voyage API key (voyage-3.5)>"

# --- 課金（Phase 4: Stripe 月額サブスク ¥300/月）---
# すべてテストモードの値で可。未設定だと /api/billing/* が 500 になる（他機能には影響しない）。
STRIPE_SECRET_KEY="<sk_test_...>"
# `stripe listen` が表示する Webhook 署名シークレット（whsec_...）。
STRIPE_WEBHOOK_SECRET="<whsec_...>"
# 円建て月次サブスクの Price ID（price_...）。
STRIPE_PRICE_ID="<price_...>"
# Checkout / Customer Portal 後の戻り先（未設定時はローカル既定 http://localhost:8787/ 系）。
# STRIPE_SUCCESS_URL="http://localhost:8787/?checkout=success"
# STRIPE_CANCEL_URL="http://localhost:8787/?checkout=cancel"
# STRIPE_PORTAL_RETURN_URL="http://localhost:8787/"
